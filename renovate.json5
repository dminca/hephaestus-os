{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "enabledManagers": ["npm", "gomod", "pip-compile", "pip_requirements", "github-actions", "custom.regex"],
  "pip-compile": {
    "managerFilePatterns": ["/^files/system/usr/share/hephaestus/python/requirements\\.txt$/"]
  },
  "pip_requirements": {
    "managerFilePatterns": ["/^\\.github/python-tools\\.txt$/"]
  },
  "schedule": ["before 7am on Monday"],
  "timezone": "UTC",
  "dependencyDashboard": true,
  "automerge": false,
  "prConcurrentLimit": 4,
  "prHourlyLimit": 0,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 7am on Monday"],
    "automerge": false,
    "groupName": "dependency lockfile maintenance"
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track Git branch commits for locked editor sources",
      "managerFilePatterns": ["files/system/usr/share/hephaestus/sources.json"],
      "matchStrings": [
        "\"repository\":\\s*\"(?<depName>[^\"]+)\",\\s*\"ref\":\\s*\"(?:HEAD|(?<currentValue>[^\"]+))\",\\s*\"revision\":\\s*\"(?<currentDigest>[a-f0-9]{40})\",\\s*\"type\":\\s*\"branch\""
      ],
      "packageNameTemplate": "https://github.com/{{{depName}}}",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "Track release tags for editor sources",
      "managerFilePatterns": ["files/system/usr/share/hephaestus/sources.json"],
      "matchStrings": [
        "\"repository\":\\s*\"(?<depName>[^\"]+)\",\\s*\"ref\":\\s*\"(?<currentValue>[^\"]+)\",\\s*\"revision\":\\s*\"\",\\s*\"type\":\\s*\"release\""
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track binary release catalog versions",
      "managerFilePatterns": ["tools/lock-binaries/main.go"],
      "matchStrings": [
        "repository:\\s*\"(?<depName>[^\"]+)\",\\s*version:\\s*\"(?<currentValue>v?[0-9][^\"]*)\""
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track signed Flow Desktop releases",
      "managerFilePatterns": ["files/scripts/install-flow-desktop.sh"],
      "matchStrings": [
        "version=(?<currentValue>v[0-9][A-Za-z0-9.+-]*)\\s+# renovate: datasource=github-releases depName=Flow-Tube/Flow-Desktop"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "Flow-Tube/Flow-Desktop",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track locked Rust source revisions",
      "managerFilePatterns": ["files/scripts/install-profile.sh"],
      "matchStrings": [
        "cargo install --locked --git https://github.com/(?<depName>[^\\s]+)\\s+\\\\\\s+--rev (?<currentDigest>[a-f0-9]{40})"
      ],
      "packageNameTemplate": "https://github.com/{{{depName}}}",
      "currentValueTemplate": "HEAD",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "Track pinned BlueBuild CLI versions",
      "managerFilePatterns": ["recipes/recipe.yml", ".github/workflows/build.yml"],
      "matchStrings": ["(?:blue-build-tag|cli_version):\\s*(?<currentValue>v[0-9.]+)"],
      "depNameTemplate": "blue-build/cli",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Track immutable BlueBuild module images",
      "managerFilePatterns": ["recipes/recipe.yml"],
      "matchStrings": ["source: (?<depName>ghcr.io/blue-build/modules/[^:]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track immutable Nushell runtime image",
      "managerFilePatterns": ["recipes/recipe.yml"],
      "matchStrings": ["nushell-version: (?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"],
      "depNameTemplate": "ghcr.io/blue-build/nushell-image",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchFileNames": ["files/system/usr/share/hephaestus/sources.json"],
      "groupName": "Neovim source pins",
      "postUpgradeTasks": {
        "commands": ["go run ./tools/lock-profile"],
        "fileFilters": ["files/system/usr/share/hephaestus/sources.lock.json"],
        "executionMode": "branch"
      }
    },
    {
      "matchPackageNames": ["saghen/blink.cmp"],
      "dependencyDashboardApproval": true,
      "groupName": "Reviewed Neovim release pins"
    },
    {
      "matchFileNames": ["tools/lock-binaries/main.go"],
      "groupName": "Pinned binary releases",
      "postUpgradeTasks": {
        "commands": ["go run ./tools/lock-binaries"],
        "fileFilters": ["files/system/usr/share/hephaestus/binaries.lock.json"],
        "executionMode": "branch"
      }
    },
    {
      "matchPackageNames": ["artempyanykh/marksman"],
      "versioning": "regex:^(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})$"
    },
    {
      "matchPackageNames": ["haskell/haskell-language-server"],
      "versioning": "loose"
    },
    {
      "matchPackageNames": ["Flow-Tube/Flow-Desktop"],
      "dependencyDashboardApproval": true,
      "groupName": "Signed Flow Desktop release",
      "postUpgradeTasks": {
        "commands": ["bash tools/update-flow-desktop-pin.sh"],
        "fileFilters": ["files/scripts/install-flow-desktop.sh"],
        "executionMode": "branch"
      }
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["files/system/usr/share/hephaestus/node/package.json"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "groupName": "npm major upgrades"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["files/system/usr/share/hephaestus/node/package.json"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "npm dependencies"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": [".github/renovate/package.json"],
      "groupName": "Renovate runtime",
      "constraintsFiltering": "strict"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["files/system/usr/share/hephaestus/node/package.json"],
      "constraintsFiltering": "strict"
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "matchPackageNames": ["node"],
      "allowedVersions": "^24.11.0"
    },
    {
      "description": "The locked Renovate native dependency graph requires Node 24.15",
      "matchManagers": ["npm"],
      "matchFileNames": [".github/renovate/package.json"],
      "matchDepTypes": ["engines"],
      "matchPackageNames": ["node"],
      "allowedVersions": "^24.15.0"
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines", "packageManager"],
      "matchPackageNames": ["npm"],
      "allowedVersions": "^11.0.0"
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["files/system/usr/share/hephaestus/node/package.json"],
      "matchPackageNames": ["typescript", "svelte-language-server", "typescript-language-server"],
      "groupName": "TypeScript and Svelte compatibility"
    },
    {
      "description": "TypeScript 7 drops tsserver and is outside the pinned Svelte peer range",
      "matchManagers": ["npm"],
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "matchManagers": ["pip-compile", "pip_requirements"],
      "groupName": "Python tools"
    },
    {
      "description": "pip-tools 7.6.1 needs pre-8.5 Click flag defaults for stable lock headers",
      "matchManagers": ["pip_requirements"],
      "matchFileNames": [".github/python-tools.txt"],
      "matchPackageNames": ["click"],
      "allowedVersions": "<8.5"
    },
    {
      "matchPackageNames": ["oxalica/nil", "nerdypepper/statix"],
      "groupName": "Rust source pins"
    },
    {
      "matchPackageNames": ["blue-build/cli", "ghcr.io/blue-build/modules/**", "ghcr.io/blue-build/nushell-image"],
      "groupName": "BlueBuild tooling",
      "dependencyDashboardApproval": true
    },
    {
      "matchManagers": ["gomod"],
      "groupName": "Go dependencies"
    },
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["github-runner"],
      "enabled": false
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions versions"
    },
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["container"],
      "dependencyDashboardApproval": true,
      "groupName": "CI container images"
    },
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
