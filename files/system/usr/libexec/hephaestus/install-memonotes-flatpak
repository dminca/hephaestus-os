#!/usr/bin/env bash
set -euo pipefail

app_id=io.github.robvaneck.Memonotes
version=v0.1.0
sha256=b8318264289d4f7adb786033d30aaa93394ba2420851b9118dc455a4b818a71f
expected_state="$version $sha256"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/hephaestus"
state_file="$state_dir/memonotes-flatpak-state"

if [[ -f "$state_file" ]] &&
  [[ "$(<"$state_file")" == "$expected_state" ]] &&
  flatpak info --user "$app_id" >/dev/null 2>&1; then
  exit 0
fi

tmpdir="$(mktemp -d)"
bundle="$tmpdir/$app_id-$version.flatpak"
trap 'rm -f -- "$bundle"; rmdir -- "$tmpdir"' EXIT

curl --fail --location --retry 5 --retry-connrefused --retry-delay 2 \
  --output "$bundle" \
  "https://github.com/robvaneck/memonotes/releases/download/$version/$app_id-$version.flatpak"

printf '%s  %s\n' "$sha256" "$bundle" | sha256sum --check
flatpak install --user --noninteractive --assumeyes --or-update "$bundle"
flatpak info --user "$app_id"

install -d "$state_dir"
printf '%s\n' "$expected_state" > "$state_file.tmp"
mv "$state_file.tmp" "$state_file"
